# ── Notion ────────────────────────────────────────────────────────────────
# Token de l'intégration Notion (https://www.notion.so/my-integrations)
# L'intégration doit être partagée avec la base « 📢 Prospects webinaire ».
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base « 📢 Prospects webinaire » (CRM IPP) — déjà créée, ID fixe :
NOTION_SETTER_DB_ID=23fb927e-d71f-467e-aa9b-07e6c97c7522

# ── System.io (synchro des tags) ──────────────────────────────────────────
# Clé MCP System.io : Paramètres → Clés MCP → colonne « Jeton ».
# Sert à : poser les tags quand la setter agit (Résa call / Pas intéressé /
# Injoignable / Réinscrit) ET à alimenter la file depuis les tags présents/absents.
SYSTEMEIO_MCP_KEY=

# Synchro ENTRANTE System.io → Notion. ACTIVE par défaut dès que la clé MCP
# est présente : passe au démarrage + tous les matins à SYSTEMEIO_SYNC_HOUR h
# (heure de Paris). Mettre à false pour couper (et piloter à la main via
# /api/sync/preview en aperçu et /api/sync/run).
SYSTEMEIO_SYNC_ENABLED=true
SYSTEMEIO_SYNC_HOUR=6            # heure de la passe quotidienne (Europe/Paris)
SYSTEMEIO_SYNC_SINCE=2026-06-01 # on ne charge que les inscrits depuis cette date
# SYSTEMEIO_SYNC_WINDOW_DAYS=14 # alternative : fenêtre glissante si SINCE non défini

# Passe « inscrits » : fait arriver dans l'onglet « 🆕 Inscrits » les personnes
# qui viennent de s'inscrire à une conférence (tags « Inscrit Webi auto Lundi » /
# « Inscrit Webi auto IA »), pour un rappel à chaud AVANT le webinaire.
# Ne crée que des fiches nouvelles, ne modifie jamais une fiche existante.
SYSTEMEIO_INSCRIT_SYNC_ENABLED=true
SYSTEMEIO_INSCRIT_POLL_MIN=5       # fréquence de la passe, en minutes
SYSTEMEIO_INSCRIT_WINDOW_HOURS=48  # on ne regarde que les inscriptions récentes

# ── Calendly (optionnel) ──────────────────────────────────────────────────
# Calendly → Intégrations → Webhooks → Signing key. Si vide, signature non vérifiée.
CALENDLY_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Envoi d'emails (replay) depuis la boîte Gmail des Instapreneurs
# Mot de passe d'application : https://myaccount.google.com/apppasswords
GMAIL_USER=contact@instapreneurpro.fr
GMAIL_APP_PASSWORD=
